    "UserBanned.UserBanned": "User successfully banned.",
    "UserBanned.SetFailed": "User could not be banned.",
    "UserBanned.BanDestroyed": "User banishment successfully destroyed.",
    "UserBanned.DestroyFailed": "User banishment could not be destroyed.",
    "UserBanned.InvalidUserId": "Invalid user identifier.",
    "UserBanned.NoKeyReason": "A ban reason is required."
}
