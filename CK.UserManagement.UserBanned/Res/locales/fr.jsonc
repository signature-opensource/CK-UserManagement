    "UserBanned.UserBanned": "Utilisateur désactivé avec succès.",
    "UserBanned.SetFailed": "L'utilisateur n'a pas pu être désactivé.",
    "UserBanned.BanDestroyed": "Utilisateur réactivé avec succès.",
    "UserBanned.DestroyFailed": "L'utilisateur n'a pas pu être réactivé.",
    "UserBanned.InvalidUserId": "Identifiant d'utilisateur invalide.",
    "UserBanned.NoKeyReason": "Un motif de désactivation est requis."
}
