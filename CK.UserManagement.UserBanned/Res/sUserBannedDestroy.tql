-- SetupConfig: {}
--
-- Adds a @WorkspaceId parameter (default 0) to CK.sUserBannedDestroy and, when a workspace is specified,
-- drives the security check from the caller's grant level on that workspace: SafeAdministrator (112)
-- or above is required. @WorkspaceId = 0 keeps the default platform route (System group).
--
-- Note: the injection point of the destroy procedure is named DestroySecurityCheck (and not
-- BannedSecurityCheck like CK.sUserBannedSet) since CK.DB.User.UserBanned 1.0.1--ci.12.
create transformer on CK.sUserBannedDestroy
as
begin
    add parameter @WorkspaceId int = 0;

    inject "
    if @WorkspaceId <> 0
    begin
        if CK.fUserWorkspaceGrantLevel( @ActorId, @WorkspaceId ) >= 112
            set @CanContinue = 1;
        else
            set @CanContinue = 0;
    end" into "DestroySecurityCheck";
end
