-- SetupConfig: {}
--
-- Adds a @WorkspaceId parameter (default 0) to CK.sUserBannedDestroy. When a workspace is specified, the
-- security check is CK.fUserAdministrationCheck: the caller must be able to administer @UserId from
-- @WorkspaceId. This includes SafeAdministrator (112) on @WorkspaceId, because @WorkspaceId is one of
-- the workspaces of @UserId. @WorkspaceId = 0 keeps the default platform route (System group).
--
-- Note: the injection point of the destroy procedure is named DestroySecurityCheck (and not
-- BannedSecurityCheck like CK.sUserBannedSet) since CK.DB.User.UserBanned 1.0.1--ci.12.
create transformer on CK.sUserBannedDestroy
as
begin
    add parameter @WorkspaceId int = 0;

    inject "
    if @WorkspaceId <> 0
    begin
        if CK.fUserAdministrationCheck( @ActorId, @WorkspaceId, @UserId, 0 ) = 0
            set @CanContinue = 1;
        else
            set @CanContinue = 0;
    end" into "DestroySecurityCheck";
end
