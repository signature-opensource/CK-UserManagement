-- SetupConfig: {}
--
-- Adds a @WorkspaceId parameter (default 0) to CK.sUserBannedSet. When a workspace is specified, the
-- security check is CK.fUserAdministrationCheck: the caller must be able to administer @UserId from
-- @WorkspaceId. This includes SafeAdministrator (112) on @WorkspaceId, because @WorkspaceId is one of
-- the workspaces of @UserId. @WorkspaceId = 0 keeps the default platform route (System group).
create transformer on CK.sUserBannedSet
as
begin
    add parameter @WorkspaceId int = 0;

    inject "
    if @WorkspaceId <> 0
    begin
        if CK.fUserAdministrationCheck( @ActorId, @WorkspaceId, @UserId, 0 ) = 0
            set @CanContinue = 1;
        else
            set @CanContinue = 0;
    end" into "BannedSecurityCheck";
end
