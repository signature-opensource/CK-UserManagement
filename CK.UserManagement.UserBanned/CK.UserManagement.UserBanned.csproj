<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handler. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="16.0.0" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="13.0.0" />

        <!-- User banishment (sUserBannedSet/sUserBannedDestroy, transformed here). -->
        <PackageReference Include="CK.DB.User.UserBanned" Version="2.0.0" />

        <!-- Workspace owns CK.fUserWorkspaceGrantLevel used by the injected security check. -->
        <PackageReference Include="CK.DB.Workspace" Version="16.0.0" />

        <!-- Back-end localized messages. -->
        <PackageReference Include="CK.DB.Globalization" Version="1.0.0" />
        <PackageReference Include="CK.Globalization.StObj" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="**\*.tql" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement.UserBanned\CK.IO.UserManagement.UserBanned.csproj" />
        <!-- For the core workspace-user contract (IWorkspaceUser / IGetWorkspaceUsersQCommand) that the
             ban-aware list handler supersedes. No tUser specialization → no StObj conflict. -->
        <ProjectReference Include="..\CK.UserManagement\CK.UserManagement.csproj" />
    </ItemGroup>

</Project>
