<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handler. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.cris-auth.1.ci.30" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="15.0.0-0.cris-auth.1.ci.9" />

        <!-- User banishment (sUserBannedSet/sUserBannedDestroy, transformed here). -->
        <PackageReference Include="CK.DB.User.UserBanned" Version="4.0.0-0.cris-auth.1.ci.41" />

        <!-- Workspace owns CK.tWorkspace, read by CK.fUserAdministrationCheck (the injected security check). -->
        <PackageReference Include="CK.DB.Workspace" Version="18.0.0-0.cris-auth.1.ci.38" />

        <!-- Back-end localized messages. -->
        <PackageReference Include="CK.DB.Globalization" Version="3.0.0-0.cris-auth.1.ci.54" />
        <PackageReference Include="CK.Globalization.StObj" Version="3.0.0-0.cris-auth.1.ci.28" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="**\*.tql" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement.UserBanned\CK.IO.UserManagement.UserBanned.csproj" />
        <!-- For the core workspace-user contract (IWorkspaceUser / IGetWorkspaceUsersQCommand) that the
             ban-aware list handler supersedes. No tUser specialization → no StObj conflict. -->
        <ProjectReference Include="..\CK.UserManagement\CK.UserManagement.csproj" />
    </ItemGroup>

</Project>
