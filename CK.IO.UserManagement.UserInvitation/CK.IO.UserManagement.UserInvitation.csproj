<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Assembly renamed, but the contract namespace is kept as CK.IO.UserManagement so the
             generated TypeScript (ck-gen) lands under CK/IO/UserManagement and the Angular imports
             are unaffected. -->
        <RootNamespace>CK.IO.UserManagement</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CK.IO.Globalization" Version="1.0.0" />
        <PackageReference Include="CK.IO.UserProfile.Workspace" Version="16.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CK.IO.Admin\CK.IO.Admin.csproj" />
        <!-- Extends the core workspace-user / edit contracts (IWorkspaceUser, IEditWorkspaceUserCommand). -->
        <ProjectReference Include="..\CK.IO.UserManagement\CK.IO.UserManagement.csproj" />
    </ItemGroup>

</Project>
