<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>{{ branding.brandName }}</title>
  <style>
    /* Progressive enhancement. Outlook desktop ignores this block — critical
       chrome + button styling is also inline below. */
    body { margin:0; padding:0; background:#f4f5f7; }
    table { border-collapse:collapse; }
    img { border:0; line-height:100%; outline:none; text-decoration:none; }
    a { color:{{ branding.primaryColor }}; }
    .mail-text { font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:1.6; color:#222222; }
    .mail-text p { margin:0 0 16px 0; }
    .mail-text p:last-child { margin-bottom:0; }
    .mail-button:hover { background-color:{{ branding.primaryColorHover }} !important; }
    @media only screen and (max-width:600px) {
      .mail-container { width:100% !important; border-radius:0 !important; }
      .mail-padding { padding:24px 20px !important; }
    }
    @media (prefers-color-scheme: dark) {
      body { background:#141518 !important; }
      .mail-container { background:#1f2023 !important; }
      .mail-text, .mail-text p { color:#e9eaec !important; }
      .mail-footer { background:#191a1d !important; color:#8a8f97 !important; border-top-color:#2a2b2e !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f5f7;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table class="mail-container" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border-radius:6px;overflow:hidden;">
          <!-- Header -->
          <tr>
            <td style="padding:28px 32px;text-align:center;background:{{ branding.headerBackgroundColor }};">
              {%- if logoUrl != "" -%}
              <img src="{{ logoUrl }}" alt="{{ branding.brandName }}" height="40" style="display:inline-block;max-height:40px;height:40px;width:auto;" />
              {%- endif -%}
            </td>
          </tr>
          <!-- Body slot -->
          <tr>
            <td class="mail-padding mail-text" style="padding:32px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#222222;">
              {{ bodyHtml }}
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td class="mail-footer" style="padding:20px 32px;background:#fafbfc;border-top:1px solid #eaecef;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#6a6f76;text-align:center;">
              {%- if branding.brandName != "" -%}
              <p style="margin:0 0 4px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#6a6f76;"><strong style="color:#3c4046;">{{ branding.brandName }}</strong></p>
              {%- endif -%}
              <p style="margin:0 0 4px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#6a6f76;">
                {%- if branding.footerAddress != "" -%}{{ branding.footerAddress }}{%- endif -%}
                {%- if branding.footerPhone != "" %} &middot; {{ branding.footerPhone }}{%- endif -%}
                {%- if branding.footerEmail != "" %} &middot; <a href="mailto:{{ branding.footerEmail }}" style="color:#6a6f76;text-decoration:underline;">{{ branding.footerEmail }}</a>{%- endif -%}
              </p>
              <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#9aa0a6;">Message automatique &mdash; merci de ne pas répondre.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
