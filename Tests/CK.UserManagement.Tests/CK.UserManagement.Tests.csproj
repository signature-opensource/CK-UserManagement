<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cris + auth markers required to build the command model of CK.UserManagement
         (commands implement ICommandWorkspaceAdmin -> ICommandAuthNormal). -->
    <PackageReference Include="CK.Cris.Auth" Version="2.0.0-juliet.0.ci.2" />
    <PackageReference Include="CK.DB.AspNet.Auth" Version="33.0.0-juliet.0.ci.2" />

    <!-- Standard CK.DB building blocks the handlers/services/queries depend on. -->
    <PackageReference Include="CK.DB.User.UserPassword.Reset" Version="30.0.0-juliet.0.ci.2" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="30.0.0-juliet.0.ci.2" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="2.0.0-juliet.0.ci.2" />
    <PackageReference Include="CK.DB.Workspace" Version="17.0.0-juliet.0.ci.3" />
    <PackageReference Include="CK.DB.Zone" Version="30.0.0-juliet.0.ci.7" />
    <PackageReference Include="CK.DB.Globalization" Version="2.0.0-juliet.0.ci.2" />
     <PackageReference Include="CK.Globalization.Engine" Version="1.0.1-juliet.0.ci.1" />

    <!-- Data access + transactions. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="16.0.1-juliet.0.ci.1" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="13.0.0" />

    <!-- Engine-side assemblies required at setup time (Cris command model). -->
    <PackageReference Include="CK.Cris.Engine" Version="2.0.0-juliet.0.ci.2" />

    <!-- Test harness. -->
    <PackageReference Include="CK.DB.Tests.NUnit" Version="35.0.0-juliet.0.ci.2" />
    <PackageReference Include="CK.Testing.Nunit" Version="16.0.0" />
    <PackageReference Include="CK.Testing.SqlServerEngine" Version="35.0.0-juliet.0.ci.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.UserManagement\CK.UserManagement.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="%24StObjGen\" />
  </ItemGroup>
</Project>
