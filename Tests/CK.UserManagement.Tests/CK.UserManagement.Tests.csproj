<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cris + auth markers required to build the command model of CK.UserManagement
         (commands implement ICommandWorkspaceAdmin -> ICommandAuthNormal). -->
    <PackageReference Include="CK.Cris.Authentication" Version="3.0.0-0.cris-auth.0.ci.70" />

    <!-- Standard CK.DB building blocks the handlers/services/queries depend on. -->
    <PackageReference Include="CK.DB.User.UserPassword.Reset" Version="31.0.0-0.cris-auth.0.ci.23" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.cris-auth.0.ci.17" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="3.0.0-0.cris-auth.0.ci.17" />
    <PackageReference Include="CK.DB.Workspace" Version="18.0.0-0.cris-auth.0.ci.11" />
    <PackageReference Include="CK.DB.Zone" Version="31.0.0-0.cris-auth.0.ci.27" />
    <PackageReference Include="CK.DB.Globalization" Version="3.0.0-0.cris-auth.0.ci.21" />
     <PackageReference Include="CK.Globalization.Engine" Version="2.0.2-0.cris-auth.0.ci.7" />

    <!-- Data access + transactions. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.cris-auth.0.ci.8" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="14.0.2-0.cris-auth.0.ci.3" />

    <!-- Engine-side assemblies required at setup time (Cris command model). -->
    <PackageReference Include="CK.Cris.Engine" Version="3.0.0-0.cris-auth.0.ci.70" />

    <!-- Test harness. -->
    <PackageReference Include="CK.DB.Tests.NUnit" Version="36.0.0-0.cris-auth.0.ci.22" />
    <PackageReference Include="CK.Testing.Nunit" Version="18.0.0-0.cris-auth.0.ci.3" />
    <PackageReference Include="CK.Testing.SqlServerEngine" Version="36.0.0-0.cris-auth.0.ci.22" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.UserManagement\CK.UserManagement.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="%24StObjGen\" />
  </ItemGroup>
</Project>
