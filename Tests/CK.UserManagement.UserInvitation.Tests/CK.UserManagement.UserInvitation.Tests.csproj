<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cris + auth markers required to build the command model (commands implement
         ICommandWorkspaceAdmin -> ICommandAuthNormal). -->
    <PackageReference Include="CK.AppIdentity.Engine" Version="3.0.0-0.uc.0.ci.156" />
    <PackageReference Include="CK.Cris.Authentication" Version="3.0.0-0.uc.0.ci.185" />

    <!-- Standard CK.DB building blocks the invitation service/queries depend on. -->
    <!-- Email-based login (specializes UserPasswordTable); brings CK.DB.User.UserPassword transitively. -->
    <PackageReference Include="CK.DB.User.UserPassword.EMailLogin" Version="31.0.0-0.uc.0.ci.107" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.uc.0.ci.100" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="3.0.0-0.uc.0.ci.100" />
    <PackageReference Include="CK.DB.User.UserBanned" Version="4.0.0-0.uc.0.ci.96" />
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="31.0.0-0.uc.0.ci.100" />
    <PackageReference Include="CK.DB.UserInvitation" Version="3.0.0-0.uc.0.ci.113" />
    <PackageReference Include="CK.DB.Workspace" Version="18.0.0-0.uc.0.ci.94" />
    <PackageReference Include="CK.DB.Zone" Version="31.0.0-0.uc.0.ci.116" />
    <PackageReference Include="CK.DB.Globalization" Version="3.0.0-0.uc.0.ci.110" />
    <PackageReference Include="CK.Globalization.Engine" Version="3.0.0-0.uc.0.ci.71" />

    <!-- Data access + transactions. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.uc.0.ci.70" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="15.0.0-0.uc.0.ci.24" />

    <!-- Engine-side assemblies required at setup time (Cris command model + Fluid mail templates). -->
    <PackageReference Include="CK.Cris.Engine" Version="3.0.0-0.uc.0.ci.185" />
    <!-- The AuthCenter (the "UserInvitation" option): the engines of an AuthCenter application. -->
    <PackageReference Include="CK.Testing.Engine.AppIdentity.AuthCenter" Version="4.0.0-0.uc.0.ci.62" />
    <PackageReference Include="CK.Template.Fluid.Engine" Version="3.0.0-0.uc.0.ci.67" />

    <!-- Test harness. -->
    <PackageReference Include="CK.DB.Tests.NUnit" Version="37.0.0-0.uc.0.ci.42" />
    <PackageReference Include="CK.Testing.Nunit" Version="18.0.0-0.uc" />
    <PackageReference Include="CK.Testing.Engine.SqlServer" Version="37.0.0-0.uc.0.ci.42" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.UserManagement.UserInvitation\CK.UserManagement.UserInvitation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
