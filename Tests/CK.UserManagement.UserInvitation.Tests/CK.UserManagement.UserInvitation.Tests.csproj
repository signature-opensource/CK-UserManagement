<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cris + auth markers required to build the command model (commands implement
         ICommandWorkspaceAdmin -> ICommandAuthNormal). -->
    <PackageReference Include="CK.Cris.Auth" Version="2.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.AspNet.Auth" Version="33.0.0-mike.0.ci.3" />

    <!-- Standard CK.DB building blocks the invitation service/queries depend on. -->
    <!-- Email-based login (specializes UserPasswordTable); brings CK.DB.User.UserPassword transitively. -->
    <PackageReference Include="CK.DB.User.UserPassword.EMailLogin" Version="30.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="30.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="2.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.User.UserBanned" Version="3.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="30.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.UserInvitation" Version="1.0.1-mike.0.ci.4" />
    <PackageReference Include="CK.DB.Workspace" Version="17.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.Zone" Version="30.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.DB.Globalization" Version="2.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.Globalization.Engine" Version="2.0.0-mike.0.ci.3" />

    <!-- Data access + transactions. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="17.0.0-mike.0.ci.4" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="14.0.0-mike.0.ci.4" />

    <!-- Engine-side assemblies required at setup time (Cris command model + Fluid mail templates). -->
    <PackageReference Include="CK.Cris.Engine" Version="2.0.0-mike.0.ci.3" />
    <PackageReference Include="CK.Template.Fluid.Engine" Version="2.0.0-mike.0.ci.3" />

    <!-- Test harness. -->
    <PackageReference Include="CK.DB.Tests.NUnit" Version="35.0.0-mike.0.ci.5" />
    <PackageReference Include="CK.Testing.Nunit" Version="17.0.0-mike.0.ci.16" />
    <PackageReference Include="CK.Testing.SqlServerEngine" Version="35.0.0-mike.0.ci.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.UserManagement.UserInvitation\CK.UserManagement.UserInvitation.csproj" />
  </ItemGroup>
</Project>
