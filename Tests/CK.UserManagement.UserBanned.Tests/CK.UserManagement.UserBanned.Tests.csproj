<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cris + auth markers required to build the command model (commands implement
         ICommandWorkspaceAdmin -> ICommandAuthNormal). -->
    <PackageReference Include="CK.Cris.Auth" Version="1.0.0--ci.1" />
    <PackageReference Include="CK.DB.AspNet.Auth" Version="32.0.0--ci.1" />

    <!-- Standard CK.DB building blocks needed to build the workspace/user setup + read model. -->
    <PackageReference Include="CK.DB.User.UserPassword" Version="29.0.0--ci.2" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="29.0.0--ci.1" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="1.0.0--ci.1" />
    <PackageReference Include="CK.DB.User.UserBanned" Version="2.0.0--ci.1" />
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="29.0.0--ci.1" />
    <PackageReference Include="CK.DB.Workspace" Version="16.0.0--ci.1" />
    <PackageReference Include="CK.DB.Zone" Version="29.0.0--ci.1" />
    <PackageReference Include="CK.DB.Globalization" Version="1.0.0--ci.1" />
    <PackageReference Include="CK.Globalization.Engine" Version="1.0.0--ci.1" />

    <!-- Data access + transactions. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="16.0.0--ci.1" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="13.0.0--ci.1" />

    <!-- Engine-side assemblies required at setup time (Cris command model). -->
    <PackageReference Include="CK.Cris.Engine" Version="1.0.0--ci.1" />

    <!-- Test harness. -->
    <PackageReference Include="CK.DB.Tests.NUnit" Version="34.0.0--ci.1" />
    <PackageReference Include="CK.Testing.Nunit" Version="16.0.0--ci.1" />
    <PackageReference Include="CK.Testing.SqlServerEngine" Version="34.0.0--ci.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.UserManagement.UserBanned\CK.UserManagement.UserBanned.csproj" />
    <!-- Core is referenced for the workspace-user read model (UserManagementQueries.GetWorkspaceUsersAsync
         exposes IWorkspaceUser.Bans) used to assert ban/unban. -->
    <ProjectReference Include="..\..\CK.UserManagement\CK.UserManagement.csproj" />
  </ItemGroup>
</Project>
