<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handlers. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="15.0.3" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="12.0.3" />

        <!-- Standard CK.DB building blocks used by the handlers. The core is e-mail/archive-agnostic:
             no CK.DB.Actor.ActorEMail nor CK.DB.User.UserBanned here (added by the UserInvitation /
             UserBanned packages). -->
        <PackageReference Include="CK.DB.Workspace" Version="15.1.3" />
        <PackageReference Include="CK.DB.Zone" Version="28.0.4" />
        <PackageReference Include="CK.DB.User.NamedUser" Version="28.0.4" />
        <!-- Temporary passwords: adds the IsTemporary bit on CK.tUserPassword so that every password
             posed by an administrator forces the user to choose a new one. Extends the table without
             specializing it, so it stays composable with CK.DB.User.UserPassword.EMailLogin (brings
             CK.DB.User.UserPassword transitively). -->
        <PackageReference Include="CK.DB.User.UserPassword.Reset" Version="28.0.4" />
        <PackageReference Include="CK.DB.User.PreferredCulture" Version="0.5.1" />
        <PackageReference Include="CK.DB.Globalization" Version="0.1.6" />
        <PackageReference Include="CK.Globalization.StObj" Version="0.1.0" />
    </ItemGroup>


    <ItemGroup>
        <EmbeddedResource Include="**\*.sql" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement\CK.IO.UserManagement.csproj" />
    </ItemGroup>

</Project>
