<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handlers. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="15.0.2--ci.1" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="12.0.1" />

        <!-- Standard CK.DB building blocks used by the handlers. The core is e-mail/archive-agnostic:
             no CK.DB.Actor.ActorEMail nor CK.DB.User.UserBanned here (added by the UserInvitation /
             UserBanned packages). -->
        <PackageReference Include="CK.DB.Workspace" Version="15.1.2--ci.1" />
        <PackageReference Include="CK.DB.Zone" Version="28.0.3--ci.1" />
        <PackageReference Include="CK.DB.User.NamedUser" Version="28.0.3--ci.1" />
        <PackageReference Include="CK.DB.User.UserPassword" Version="28.0.3--ci.5" />
        <PackageReference Include="CK.DB.User.PreferredCulture" Version="0.5.0--ci.7" />
        <PackageReference Include="CK.DB.Globalization" Version="0.1.5--ci.1" />
        <PackageReference Include="CK.Globalization.StObj" Version="0.0.0--ci.7" />
    </ItemGroup>


    <ItemGroup>
        <EmbeddedResource Include="**\*.sql" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement\CK.IO.UserManagement.csproj" />
    </ItemGroup>

</Project>
