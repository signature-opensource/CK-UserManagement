<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handlers. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.uc.0.ci.35" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="15.0.0-0.cris-auth.1.ci.11" />

        <!-- Standard CK.DB building blocks used by the handlers. The core is e-mail/archive-agnostic:
             no CK.DB.Actor.ActorEMail nor CK.DB.User.UserBanned here (added by the UserInvitation /
             UserBanned packages). -->
        <PackageReference Include="CK.DB.Workspace" Version="18.0.0-0.uc.0.ci.49" />
        <PackageReference Include="CK.DB.Zone" Version="31.0.0-0.uc.0.ci.70" />
        <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.uc.0.ci.55" />
        <!-- Temporary passwords: adds the IsTemporary bit on CK.tUserPassword so that every password
             posed by an administrator forces the user to choose a new one. Extends the table without
             specializing it, so it stays composable with CK.DB.User.UserPassword.EMailLogin (brings
             CK.DB.User.UserPassword transitively). -->
        <PackageReference Include="CK.DB.User.UserPassword.Reset" Version="31.0.0-0.uc.0.ci.62" />
        <PackageReference Include="CK.DB.User.PreferredCulture" Version="3.0.0-0.uc.0.ci.55" />
        <PackageReference Include="CK.DB.Globalization" Version="3.0.0-0.uc.0.ci.65" />
        <PackageReference Include="CK.Globalization.StObj" Version="3.0.0-0.uc.0.ci.34" />
    </ItemGroup>


    <ItemGroup>
        <EmbeddedResource Include="**\*.sql" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement\CK.IO.UserManagement.csproj" />
    </ItemGroup>

</Project>
