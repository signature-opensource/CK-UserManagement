{
    // Root ("en") translation set for CK.UserManagement back-end messages.
    // Keys are the resName arguments passed to the UserMessage helpers from the
    // command handlers and validators of this package. Invitation and archive/restore
    // messages live in CK.UserManagement.UserInvitation and CK.UserManagement.BinnedUser.

    // AdminCommandValidator
    "Admin.InvalidActor": "Invalid actor.",
    "Admin.InvalidWorkSpace": "Invalid workspace.",
    "Admin.NotAuthorized": "Admin authority required.",

    // UserMessageExtensions (generic answers)
    "CrisError.ExceptionCaught": "An error occured.",
    "CrisError.InvalidActorId": "Please logout and relog-in, we were unable to identify you.",
    "CrisError.ArgumentError": "Invalid arguments.",

    // CommandHandler success answers
    "CrisSuccess.WorkspaceUserEdited": "Workspace user successfully edited.",

    // Workspace user edit
    "User.EmailAlreadyUsed": "This e-mail address is already used by another user."
}
