<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handlers. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="17.0.0-mike.0.ci.4" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="14.0.0-mike.0.ci.4" />

        <!-- Invitation persistence + the standard CK.DB building blocks used by the service. -->
        <PackageReference Include="CK.DB.UserInvitation" Version="1.0.1-mike.0.ci.3" />
        <PackageReference Include="CK.DB.User.PreferredCulture" Version="2.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.DB.User.NamedUser" Version="30.0.0-mike.0.ci.3" />
        <!-- Email-based login: specializes UserPasswordTable so the "Basic" provider accepts a
             validated CK.tActorEMail as login identifier (brings CK.DB.User.UserPassword transitively). -->
        <PackageReference Include="CK.DB.User.UserPassword.EMailLogin" Version="30.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.DB.Actor.ActorEMail" Version="30.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.DB.Zone" Version="30.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.DB.Workspace" Version="17.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.DB.Globalization" Version="2.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.Globalization.StObj" Version="2.0.0-mike.0.ci.3" />

        <!-- Invitation e-mail: Fluid templates rendered + sent via the CK-AppIdentity-configured mailer.
             Res/Templates/*.liquid are auto-embedded by CK.EmbeddedResources (buildTransitive). -->
        <PackageReference Include="CK.Mailer.MailKit" Version="14.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.Template.Fluid" Version="2.0.0-mike.0.ci.3" />
        <PackageReference Include="CK.AppIdentity.Abstractions" Version="2.0.0-mike.0.ci.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement.UserInvitation\CK.IO.UserManagement.UserInvitation.csproj" />
        <ProjectReference Include="..\CK.UserManagement\CK.UserManagement.csproj" />
        <ProjectReference Include="..\CK.Mail.SharedLayout\CK.Mail.SharedLayout.csproj" />
    </ItemGroup>

</Project>
