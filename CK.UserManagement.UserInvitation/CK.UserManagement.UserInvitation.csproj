<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handlers. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="15.1.1" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="12.0.6" />

        <!-- Invitation persistence + the standard CK.DB building blocks used by the service. -->
        <PackageReference Include="CK.DB.UserInvitation" Version="0.5.1" />
        <PackageReference Include="CK.DB.User.PreferredCulture" Version="0.6.1" />
        <PackageReference Include="CK.DB.User.NamedUser" Version="28.1.1" />
        <!-- Email-based login: specializes UserPasswordTable so the "Basic" provider accepts a
             validated CK.tActorEMail as login identifier (brings CK.DB.User.UserPassword transitively). -->
        <PackageReference Include="CK.DB.User.UserPassword.EMailLogin" Version="28.1.1" />
        <PackageReference Include="CK.DB.Actor.ActorEMail" Version="28.1.1" />
        <PackageReference Include="CK.DB.Zone" Version="28.1.1" />
        <PackageReference Include="CK.DB.Workspace" Version="15.2.1" />
        <PackageReference Include="CK.DB.Globalization" Version="0.2.1" />
        <PackageReference Include="CK.Globalization.StObj" Version="0.2.1" />

        <!-- Invitation e-mail: Fluid templates rendered + sent via the CK-AppIdentity-configured mailer.
             Res/Templates/*.liquid are auto-embedded by CK.EmbeddedResources (buildTransitive). -->
        <PackageReference Include="CK.Mailer.MailKit" Version="12.1.1" />
        <PackageReference Include="CK.Template.Fluid" Version="0.1.1" />
        <PackageReference Include="CK.AppIdentity.Abstractions" Version="0.14.6" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement.UserInvitation\CK.IO.UserManagement.UserInvitation.csproj" />
        <ProjectReference Include="..\CK.UserManagement\CK.UserManagement.csproj" />
        <ProjectReference Include="..\CK.Mail.SharedLayout\CK.Mail.SharedLayout.csproj" />
    </ItemGroup>

</Project>
